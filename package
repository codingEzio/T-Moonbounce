#!/bin/zsh
set -euo pipefail
cd "${0:A:h}"
stamp="$(date +%Y%m%d-%H%M%S)-$$"
stage="$PWD/.local/package-$stamp"
app="$stage/Moonbounce.app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
CGO_ENABLED=0 GOMAXPROCS=4 go build -trimpath -o "$app/Contents/MacOS/Moonbounce" .
cat > "$app/Contents/Info.plist" <<'PLIST'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>io.github.codingezio.moonbounce</string>
<key>CFBundleName</key><string>Moonbounce</string>
<key>CFBundleExecutable</key><string>Moonbounce</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>0.4.1</string>
<key>CFBundleVersion</key><string>5</string>
<key>NSHighResolutionCapable</key><true/>
<key>LSMinimumSystemVersion</key><string>14.0</string>
</dict></plist>
PLIST
# Keep redistribution notices with the self-contained app, not only in Git.
cp LICENSE DEPENDENCIES.md "$app/Contents/Resources/"
mkdir -p "$app/Contents/Resources/assets/fonts" "$app/Contents/Resources/assets/audio"
cp -R assets/licenses "$app/Contents/Resources/assets/"
cp -R assets/fonts/licenses "$app/Contents/Resources/assets/fonts/"
cp assets/fonts/OFL.txt assets/fonts/NOTICE.md assets/fonts/provenance.json "$app/Contents/Resources/assets/fonts/"
cp assets/audio/CC0-1.0.txt assets/audio/CREDITS.md "$app/Contents/Resources/assets/audio/"
/usr/bin/plutil -lint "$app/Contents/Info.plist"
/usr/bin/codesign --force --sign - "$app"
/usr/bin/codesign --verify --strict "$app"
# Build/sign first. Preserve the prior bundle (including any running image).
if [[ -e .local/Moonbounce.app ]]; then
  mv .local/Moonbounce.app ".local/Previous-Moonbounce-$stamp.app"
fi
mv "$app" .local/Moonbounce.app
rmdir "$stage"
print "$PWD/.local/Moonbounce.app"
